<Project Sdk="Aspire.AppHost.Sdk/13.2.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>3ec7e775-f92a-4689-a953-ace8967ed6b8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.NodeJs" Version="9.5.2" />
  </ItemGroup>

  <!--
    Restore Node.js dependencies automatically as part of the MSBuild build phase so
    that developers only need to run `dotnet run` without a prior `npm install`.
    Only runs when node_modules is missing (i.e. dependencies are not yet installed)
    and is skipped during IDE design-time builds.
  -->
  <Target Name="NpmInstall" BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' And Exists('$(MSBuildThisFileDirectory)../../package-lock.json') And !Exists('$(MSBuildThisFileDirectory)../../node_modules')">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
  </Target>

</Project>
